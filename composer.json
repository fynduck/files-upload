{
  "name": "fynduck/files-upload",
  "version": "5.0.0",
  "description": "Save & resize & crop images",
  "keywords": [
    "fynduck",
    "laravel",
    "files-upload"
  ],
  "homepage": "https://github.com/fynduck/files-upload",
  "license": "MIT",
  "authors": [
    {
      "name": "fynduck",
      "email": "stason.k12@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-fileinfo": "*",
    "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "intervention/image": "^4.3",
    "intervention/image-laravel": "^4.1",
    "symfony/process": "^6.2|^7.0|^8.0"
  },
  "require-dev": {
    "laravel/pint": "1.20",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.5.3|^12.0",
    "rector/rector": "^2.4",
    "spatie/laravel-image-optimizer": "^1.8"
  },
  "suggest": {
    "spatie/laravel-image-optimizer": "Optimize stored images (setOptimize). Needs jpegoptim/pngquant/... binaries.",
    "intervention/image-driver-vips": "Use libvips as the image driver (set intervention-image.driver).",
    "ext-exif": "Read EXIF orientation so photos are stored upright."
  },
  "autoload": {
    "psr-4": {
      "Fynduck\\FilesUpload\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fynduck\\FilesUpload\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": "@composer run prepare",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "analyse": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage",
    "format": "vendor/bin/pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fynduck\\FilesUpload\\FilesUploadServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
